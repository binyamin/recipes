{
	"font": {
		"$type": "fontFamily",
		"body": {
			"$value": "{font.sans}"
		},
		"heading": {
			"$value": "{font.sans}"
		}
	},
	"color": {
		"$type": "color",

		"surface": {
			"base": {
				"$value": "{color.white}"
			},
			"raised": {
				"$value": "{color.white}"
			},
			"lowered": {
				"$value": "{color.neutral.100}"
			}
		},

		"text": {
			"base": {
				"$value": "{color.neutral.900}"
			},
			"link": {
				"$description": "Tailwind's blue/600",
				"$value": {
					"colorSpace": "oklch",
					"components": [0.55, 0.22, 263],
					"alpha": 1,
					"hex": "#2563eb"
				}
			}
		},

		"border": {
			"subtle": {
				"$value": "{color.neutral.200}"
			},
			"base": {
				"$value": "{color.neutral.300}"
			}
		},

		"white": {
			"$value": "#FFFFFF"
		},
		"black": {
			"$value": "#000000"
		}
	}
}
