{
	"font": {
		"$type": "fontFamily",
		"body": {
			"$value": "{font.sans}"
		},
		"heading": {
			"$value": "{font.sans}"
		}
	},
	"color": {
		"$type": "color",

		"surface": {
			"base": {
				"$value": "{color.white}"
			},
			"raised": {
				"$value": "{color.white}"
			},
			"lowered": {
				"$value": "{color.neutral.100}"
			}
		},

		"text": {
			"base": {
				"$value": "{color.neutral.900}"
			},
			"link": {
				"$value": "{color.text.base}"
			}
		},

		"border": {
			"subtle": {
				"$value": "{color.neutral.200}"
			},
			"base": {
				"$value": "{color.neutral.300}"
			},
			"focus": {
				"$value": "{color.neutral.700}"
			}
		},

		"white": {
			"$value": "#FFFFFF"
		},
		"black": {
			"$value": "#000000"
		}
	}
}
